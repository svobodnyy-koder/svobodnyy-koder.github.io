def norm(s):
    return re.sub(r'[^a-z0-9]','', s.lower())

def find_hotspot(page_words, tokens, hint):
    """Find bounding box center for a group of tokens on the page."""
    ntokens = [norm(t) for t in tokens]
    # Try to find consecutive or nearby words matching all tokens
    best = None
    best_score = -1
    for i, w in enumerate(page_words):
        left, top, wd, h, text = w
        nt = norm(text)
        if ntokens[0] in nt or nt in ntokens[0]:
            # check remaining tokens in nearby words (within 200px horizontally, 60px vertically)
            matched = [ntokens[0]]
            cx, cy = left + wd/2, top + h/2
            min_x, max_x = left, left+wd
            min_y, max_y = top, top+h
            for j, w2 in enumerate(page_words):
                if j == i: continue
                l2,t2,w2d,h2,t2x = w2
                nt2 = norm(t2x)
                if abs((l2+w2d/2)-cx) < 250 and abs((t2+h2/2)-cy) < 80:
                    for tk in ntokens[1:]:
                        if tk in nt2 or nt2 in tk:
                            if tk not in matched:
                                matched.append(tk)
                                min_x = min(min_x, l2)
                                max_x = max(max_x, l2+w2d)
                                min_y = min(min_y, t2)
                                max_y = max(max_y, t2+h2)
            score = len(matched)
            if score > best_score:
                best_score = score
                best = ((min_x+max_x)/2, (min_y+max_y)/2, max_x-min_x, max_y-min_y)
    if best and best_score >= len(ntokens) * 0.5:
        cx, cy, bw, bh = best
        return (round(cx/W*100, 1), round(cy/H*100, 1))
    return None

hotspots = {}
for page, labels in ANATOMY_TERMS.items():
    words = ocr.get(page, [])
    page_hotspots = []
    used_positions = []
    for label, tokens, hint in labels:
        pos = find_hotspot(words, tokens, hint)
        if pos:
            # Avoid duplicate positions
            too_close = any(abs(pos[0]-p[0])<5 and abs(pos[1]-p[1])<5 for p in used_positions)
            if not too_close:
                page_hotspots.append({'label': label, 'x': pos[0], 'y': pos[1]})
                used_positions.append(pos)
    if page_hotspots:
        hotspots[page] = page_hotspots

Path('hotspots.json').write_text(json.dumps(hotspots, ensure_ascii=False, indent=2))
